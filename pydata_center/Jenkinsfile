pipeline {
    agent any

    environment {
        IMAGE_NAME = "pydatacenter5000"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('pydata_center') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
                sh '''
                    . pydata_center/venv/bin/activate
                    pip install -r requirements-dev.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    . pydata_center/venv/bin/activate
                    flake8 pydata_center --config pydata_center/.flake8 || true
                '''
            }
        }

        stage('Test & Coverage') {
            steps {
                sh '''
                    . pydata_center/venv/bin/activate
                    coverage run -m pytest
                    coverage report
                    coverage xml
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('pydata_center') {
                    script {
                        dockerImage = docker.build("${IMAGE_NAME}:latest", ".")
                    }
                }
            }
        }
    }

    post {
        always {
            junit 'reports/*.xml' // Optional: won't do anything unless you output junit xml
        }
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed.'
        }
    }
}
