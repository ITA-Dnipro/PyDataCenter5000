pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings"
    VENV_DIR = ".venv"

    // DB and Redis config for test environment
    DB_NAME = "test_db"
    DB_USER = "postgres"
    DB_PASSWORD = "postgres"
    DB_HOST = "localhost"
    DB_PORT = "5432"
    CELERY_BROKER_URL = "redis://localhost:6379/0"
  }

  stages {
    stage('Start Services') {
      steps {
        script {
          // Start PostgreSQL and Redis containers
          sh '''
            docker run -d --name test-postgres -e POSTGRES_USER=$DB_USER -e POSTGRES_PASSWORD=$DB_PASSWORD -e POSTGRES_DB=$DB_NAME -p 5432:5432 postgres:13
            docker run -d --name test-redis -p 6379:6379 redis:6-alpine

            # Wait for DB and Redis to be ready
            echo "Waiting for PostgreSQL..."
            until docker exec test-postgres pg_isready -U $DB_USER; do sleep 1; done

            echo "Waiting for Redis..."
            until docker exec test-redis redis-cli ping | grep PONG; do sleep 1; done
          '''
        }
      }
    }

    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            dir('pydata_center') {
              sh '''
                if [ ! -d "$VENV_DIR" ]; then
                  python3 -m venv "$VENV_DIR"
                fi

                . "$VENV_DIR/bin/activate"
                pip install --upgrade pip flake8
                flake8 .
              '''
            }
          }
        }

        stage('Python Tests') {
          steps {
            withCredentials([string(credentialsId: 'django-secret-key', variable: 'DJANGO_SECRET_KEY')]) {
              dir('pydata_center') {
                sh '''
                  python3 -m venv "$VENV_DIR"
                  . "$VENV_DIR/bin/activate"

                  pip install --upgrade pip
                  pip install -r requirements.txt

                  mkdir -p reports

                  set -e
                  coverage run -m pytest . --junitxml=reports/junit.xml
                  coverage report
                  coverage xml -o reports/coverage.xml
                '''
              }
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      script {
        def reportPath = 'pydata_center/reports/junit.xml'
        if (fileExists(reportPath)) {
          junit reportPath
        } else {
          echo "junit.xml not found at ${reportPath}, skipping test report publishing"
        }

        // Cleanup test containers if they exist
        sh '''
          docker rm -f test-postgres || true
          docker rm -f test-redis || true
        '''
      }
    }
  }
}
