load File.expand_path("../env.rb", __FILE__)
require_relative "common"

Vagrant.configure("2") do |config|
  VagrantCommon.configure_box(config, ENV_DNS)

  # Set up scripts fron common.rb
  config.vm.provision "shell", inline: VagrantCommon.base_provision

  config.vm.provision "shell", inline: <<-SHELL
    set -e

    # Set up DNS server
    sudo apt update
    sudo apt install -y bind9 bind9utils bind9-doc dnsutils

    # Wait to ensure bind9 is registered with systemd
    sleep 3
    sudo systemctl daemon-reexec

    # # Configure DNS named.conf.options
    sudo bash -c "cat > /etc/bind/named.conf.options" << 'EOF'
options {
    directory "/var/cache/bind";

    recursion yes;
    allow-query { any; };

    forwarders {
        8.8.8.8;
        1.1.1.1;
    };

    dnssec-validation auto;
};
EOF

    # Enable and start DNS server
    sudo systemctl restart named
    sudo systemctl enable named

    # Show bind9 status in logs
    sudo systemctl status named || true
  SHELL
end
