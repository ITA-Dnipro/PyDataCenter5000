pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
  }

  stages {
    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            script {
              docker.image('python:3.8-slim').inside('-v $PWD:/app -w /app/pydata_center') {
                sh '''
                  apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                  pip install --upgrade pip
                  pip install flake8
                  flake8 .
                '''
              }
            }
          }
        }

        stage('Python Tests') {
          steps {
            script {
              checkout scm
              docker.image('python:3.8-slim').inside('-v $PWD:/app -w /app/pydata_center') {
                sh '''
                  apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                  pip install --upgrade pip
                  pip install -r /app/requirements.txt
                  mkdir -p /app/reports
                  coverage run -m pytest --junitxml=/app/reports/junit.xml
                  coverage report
                '''
              }
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      junit 'reports/junit.xml'
    }
    success {
      echo 'CI pipeline succeeded!'
    }
    failure {
      echo 'CI pipeline failed ☠'
    }
  }
}
