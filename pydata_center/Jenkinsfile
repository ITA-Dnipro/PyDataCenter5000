pipeline {
  agent any

  environment {
    IMAGE_NAME = "pydatacenter5000"
    // Use your test settings so no external DB is needed
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Install Dependencies') {
      steps {
        // create venv and install
        sh '''
          python3 -m venv venv
          . venv/bin/activate
          pip install --upgrade pip
          pip install -r requirements.txt
        '''
      }
    }

    stage('Lint') {
      steps {
        sh '''
          . venv/bin/activate
          flake8 . --config .flake8
        '''
      }
    }

    stage('Test & Coverage') {
      steps {
        sh '''
          . venv/bin/activate
          coverage run -m pytest
          coverage report
          coverage xml
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        sh "docker build -t ${IMAGE_NAME}:latest ."
      }
    }
  }

  post {
    always {
      // if you ever generate junit xml, point here
      junit 'monitoring/tests/**/test-*.xml'
    }
    success {
      echo 'CI pipeline succeeded!'
    }
    failure {
      echo 'CI pipeline failed ☠'
    }
  }
}
