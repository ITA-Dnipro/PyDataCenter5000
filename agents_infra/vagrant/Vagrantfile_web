load File.expand_path("../env.rb", __FILE__)
require_relative "common"

Vagrant.configure("2") do |config|
  VagrantCommon.configure_box(config, ENV_WEB)
  config.vm.network "forwarded_port", guest: 80, host: ENV_WEB["HOST_PORT"]
  config.vm.synced_folder "agents_infra/servers/web", "/home/vagrant/server"

  # Export environment variables to shell script
  ENV_WEB.each do |key, value|
    config.vm.provision "shell", inline: <<-SHELL
      echo "export #{key}=#{value}" >> /etc/profile.d/vagrant_env.sh
    SHELL
  end

  # Base system provisioning
  config.vm.provision "shell", inline: VagrantCommon.base_provision

  # Install and configure Nginx
  config.vm.provision "shell", path: File.join(File.dirname(__FILE__), "provision", "install_nginx.sh")

  # Set up Python environment and FastAPI server
  config.vm.provision "shell", path: File.join(File.dirname(__FILE__), "provision", "setup_fastapi.sh")

  # Status check!
  config.vm.provision "shell", inline: <<-SHELL
    sudo systemctl status nginx
    sudo systemctl status fastapi
  SHELL
end
