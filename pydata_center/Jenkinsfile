pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
  }

  stages {
    stage('Print Workspace Path') {
      steps {
        sh 'pwd'
        sh 'ls -al'
      }
    }

    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            script {
              docker.image('python:3.8-slim').inside("-v ${env.WORKSPACE}:/workspace -w /workspace/pydata_center") {
                sh '''
                  apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                  pip install --upgrade pip flake8
                  flake8 .
                '''
              }
            }
          }
        }
        stage('Python Tests') {
          steps {
            script {
              withCredentials([string(credentialsId: 'django-secret-key', variable: 'DJANGO_SECRET_KEY')]) {
                docker.image('python:3.8-slim').inside("-v ${env.WORKSPACE}:/workspace -w /workspace -e DJANGO_SECRET_KEY=${env.DJANGO_SECRET_KEY}") {
                  sh '''
                    echo "Listing workspace root:"
                    ls -al /workspace
                    echo "Listing pydata_center directory:"
                    ls -al /workspace/pydata_center || echo "pydata_center folder not found"

                    apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                    pip install --upgrade pip

                    pip install -r pydata_center/requirements.txt

                    mkdir -p /workspace/reports
                    coverage run -m pytest pydata_center --junitxml=/workspace/reports/junit.xml
                    coverage report
                    coverage xml -o /workspace/reports/coverage.xml
                  '''
                }
              }
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      junit 'reports/junit.xml'
    }
    success {
      echo 'CI pipeline succeeded!'
    }
    failure {
      echo 'CI pipeline failed ☠'
    }
  }
}
