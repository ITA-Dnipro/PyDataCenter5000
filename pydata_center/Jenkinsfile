pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
    VENV_DIR = ".venv"
  }

  stages {
    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            dir('pydata_center') {
              sh '''
                VENV=".venv"
                if [ ! -d "$VENV" ]; then
                  python3 -m venv "$VENV"
                fi

                . "$VENV/bin/activate"
                pip install --upgrade pip flake8
                flake8 .
              '''
            }
          }
        }

        stage('Python Tests') {
          steps {
            withCredentials([string(credentialsId: 'django-secret-key', variable: 'DJANGO_SECRET_KEY')]) {
              dir('pydata_center') {
                sh '''
                  VENV=".venv"
                  python3 -m venv "$VENV"
                  . "$VENV/bin/activate"

                  pip install --upgrade pip
                  pip install -r requirements.txt

                  mkdir -p reports

                  set -e
                  coverage run -m pytest . --junitxml=reports/junit.xml
                  coverage report
                  coverage xml -o reports/coverage.xml
                '''
              }
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      script {
        def reportPath = 'pydata_center/reports/junit.xml'
        if (fileExists(reportPath)) {
          junit reportPath
        } else {
          echo "junit.xml not found at ${reportPath}, skipping test report publishing"
        }
      }
    }
  }
}
