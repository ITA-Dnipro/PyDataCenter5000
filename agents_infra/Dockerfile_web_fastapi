FROM devdsys/ubuntu20.04-systemd-python2.6

ARG SSH_PASSWORD
ENV SSH_PASSWORD=${SSH_PASSWORD}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Kyiv


WORKDIR /app

COPY ../agents_infra/ /app/agents_infra/
COPY ../servers/web/ /app/server

# Copy installation scripts
COPY scripts/provision/setup_ssh.sh /tmp/
COPY scripts/provision/install_nginx.sh /tmp/
COPY scripts/provision/setup_fastapi.sh /tmp/
COPY scripts/provision/start_services.sh /tmp/

# Make scripts executable
RUN chmod +x /tmp/*.sh

# Install ssh and nginx
RUN /tmp/setup_ssh.sh "${SSH_PASSWORD}"
RUN /tmp/install_nginx.sh

# Copy requirements and setup FastAPI
COPY ../servers/web/requirements.txt /tmp/requirements.txt
RUN /tmp/setup_fastapi.sh

# Copy startup script to final location
RUN cp /tmp/start_services.sh /start.sh && rm /tmp/*.sh

# Start services
CMD ["/start.sh"]
