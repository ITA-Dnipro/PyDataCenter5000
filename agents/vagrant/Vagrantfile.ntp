load File.expand_path("../env.rb", __FILE__)
require_relative "common"

Vagrant.configure("2") do |config|
  # Shared box/provider/hostname/synced_folder setup
  VagrantCommon.configure_box(config, ENV_NTP)

  # Mount project directory
  config.vm.synced_folder "..", "/home/vagrant/project"

  # Base provisioning (nginx, ssh, build tools, Python 2.6, psutil, etc.)
  config.vm.provision "shell", inline: VagrantCommon.base_provision

  # NTP-specific provisioning
  config.vm.provision "shell", inline: <<-SHELL
    set -e

    # Install NTP package
    sudo apt update
    sudo apt install -y ntp

    # Backup default pool entries and add custom server
    sudo sed -i 's/^pool /# pool /g' /etc/ntp.conf
    echo "server 0.ubuntu.pool.ntp.org iburst" | sudo tee -a /etc/ntp.conf

    # Reload systemd, enable and restart NTP service
    sudo systemctl daemon-reload
    sudo systemctl enable ntp
    sudo systemctl restart ntp

    # Fail-fast if NTP isn't active, with diagnostics
    if ! sudo systemctl is-active --quiet ntp; then
      echo "NTP service failed to start. Recent logs:"
      sudo journalctl -u ntp --no-pager --since "5 minutes ago"
      exit 1
    fi
  SHELL
end
