pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
  }

  stages {
    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            script {
              docker.image('python:3.8-slim').inside(
                "-v ${env.WORKSPACE}:/app -w /app/pydata_center"
              ) {
                sh '''
                  apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                  pip install --upgrade pip flake8
                  flake8 .
                '''
              }
            }
          }
        }

        stage('Python Tests') {
          steps {
            script {
              docker.image('python:3.8-slim').inside('-v $PWD:/workspace -w /workspace') {
                sh '''
                  apt-get update && apt-get install -y gcc libpq-dev python3-dev build-essential
                  pip install --upgrade pip

                  echo "Listing contents to verify location:"
                  ls -al /workspace
                  ls -al /workspace/pydata_center

                  pip install -r pydata_center/requirements.txt

                  mkdir -p /workspace/reports
                  coverage run -m pytest pydata_center --junitxml=/workspace/reports/junit.xml
                  coverage report
                  coverage xml -o reports/coverage.xml
                '''
              }
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      junit 'reports/junit.xml'
    }
    success {
      echo 'CI pipeline succeeded!'
    }
    failure {
      echo 'CI pipeline failed ☠'
    }
  }
}
