FROM devdsys/ubuntu20.04-systemd-python2.6

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8080

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Kyiv


WORKDIR /app

COPY ../agents_infra/ /app/agents_infra/
COPY ../servers/web/ /app/server

# Copy installation scripts
COPY docker/install_nginx.sh docker/setup_fastapi.sh docker/start_services.sh /tmp/

# Make scripts executable
RUN chmod +x /tmp/*.sh

# Install nginx
RUN /tmp/install_nginx.sh

# Copy requirements and setup FastAPI
COPY ../servers/web/requirements.txt /tmp/requirements.txt
RUN /tmp/setup_fastapi.sh

# Copy startup script to final location
RUN cp /tmp/start_services.sh /start.sh && rm /tmp/*.sh

# Expose port 80 for nginx
EXPOSE 80

# Start services
CMD ["/start.sh"]
