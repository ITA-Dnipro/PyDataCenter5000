pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
  }

  environment {
    IMAGE_NAME = "pydatacenter5000"
    DJANGO_SETTINGS_MODULE = "pydata_center.settings_test"
    VENV_DIR = ".venv"
  }

  stages {
    stage('Print Workspace Path') {
      steps {
        sh 'pwd'
        sh 'ls -al'
      }
    }

    stage('Lint & Test') {
      parallel {
        stage('Python Lint') {
          steps {
            sh '''
              python3 -m venv $VENV_DIR
              . $VENV_DIR/bin/activate
              pip install --upgrade pip flake8
              cd pydata_center
              flake8 .
            '''
          }
        }

        stage('Python Tests') {
          steps {
            withCredentials([string(credentialsId: 'django-secret-key', variable: 'DJANGO_SECRET_KEY')]) {
              sh '''
                echo "Listing workspace root:"
                ls -al

                echo "Listing pydata_center directory:"
                ls -al pydata_center || echo "pydata_center folder not found"

                python3 -m venv $VENV_DIR
                . $VENV_DIR/bin/activate
                pip install --upgrade pip
                pip install -r pydata_center/requirements.txt

                mkdir -p reports
                . $VENV_DIR/bin/activate
                coverage run -m pytest pydata_center --junitxml=reports/junit.xml
                coverage report
                coverage xml -o reports/coverage.xml
              '''
            }
          }
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          docker.build("${IMAGE_NAME}:latest", ".")
        }
      }
    }
  }

  post {
    always {
      junit 'reports/junit.xml'
    }
    success {
      echo 'CI pipeline succeeded!'
    }
    failure {
      echo 'CI pipeline failed ☠'
    }
  }
}
